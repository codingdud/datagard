NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Microsoft Fabric (replace with real values)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
FABRIC_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=YourLakehouseName

# Optional: token scope (default https://database.windows.net/.default)
# FABRIC_SCOPE=https://database.windows.net/.default
